# Susie McCalister Website - Environment Variables
# Copy this file to .env and fill in the values

# Public URL of the website
VITE_SITE_URL=https://your-domain.vercel.app

# Discord Bot Client ID (found in Discord Developer Portal)
VITE_DISCORD_CLIENT_ID=

# Full Discord OAuth2 invite URL (optional - auto-generated from Client ID if not set)
VITE_DISCORD_INVITE_URL=

# Discord support server invite link
VITE_DISCORD_SUPPORT_URL=
